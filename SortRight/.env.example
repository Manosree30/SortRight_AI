# =========================================================
# SortRight AI - Environment Variable Configuration Template
# All secrets and API credentials must be set with your own values.
# DO NOT commit .env with real secrets to version control.
# =========================================================

# Groq Cloud API Credentials
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Architecture
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_BACKUP_VISION_MODEL=
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Server Binding Configuration (Render provides $PORT automatically)
PORT=8000
HOST=0.0.0.0

# Mandatory Session Secret Key (used for cryptographic session validation)
SESSION_SECRET=your_long_random_session_secret_key_here

# Demo Mode Flag (MUST default to false in production)
DEMO_MODE=false

# Demo Account Client Pre-Fill Passwords (Only active when DEMO_MODE=true)
DEMO_MUNICIPALITY_PASSWORD=DemoMuni2026!
DEMO_RECYCLER_PASSWORD=DemoRecycle2026!

# Authorized Staff Accounts - Municipality Officer
MUNICIPALITY_EMAIL=municipality@demo.example
MUNICIPALITY_NAME=Demo Municipality User
MUNICIPALITY_PASSWORD_HASH=$2b$12$your_bcrypt_hash_for_municipality_password_here

# Authorized Staff Accounts - Recycler Partner
RECYCLER_EMAIL=recycler@demo.example
RECYCLER_NAME=Demo Recycler User
RECYCLER_PASSWORD_HASH=$2b$12$your_bcrypt_hash_for_recycler_password_here
